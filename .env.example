# --- Application ---
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="Inventory Management API"

# --- Database ---
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=inventory_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inventory_user:change_me_in_production@localhost:5432/inventory_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT Security ---
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Inventory Business Rules ---
LOW_STOCK_ALERT_THRESHOLD_DEFAULT=10